# MongoDB connection string
MONGO_URI=your_mongodb_connection_string_here

# Node environment
NODE_ENV=development

# Port for the server (optional, defaults to 3000)
PORT=3000

# CORS origins (comma-separated, e.g., "https://myfrontend.com,https://anotherdomain.com")
# For production deployments, include your frontend domain
CORS_ORIGINS=https://ecom-cart-demo.vercel.app

# For production deployments
# NODE_ENV=production
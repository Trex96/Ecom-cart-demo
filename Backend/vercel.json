{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/server.js"
    },
    {
      "src": "/api/products",
      "dest": "/server.js"
    },
    {
      "src": "/api/products/.*",
      "dest": "/server.js"
    },
    {
      "src": "/api/cart",
      "methods": ["GET", "POST"],
      "dest": "/server.js"
    },
    {
      "src": "/api/cart/.*",
      "methods": ["PUT", "DELETE"],
      "dest": "/server.js"
    },
    {
      "src": "/api/checkout",
      "methods": ["POST"],
      "dest": "/server.js"
    },
    {
      "src": "/api/checkout/.*",
      "methods": ["GET"],
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}